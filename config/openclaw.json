{
  "agents": {
    "defaults": {
      "workspace": "/root/.openclaw/workspace",
      "mediaMaxMb": 200,
      "model": {
        "primary": "deepseek/deepseek-flash"
      },
      "imageGenerationModel": {
        "primary": "glm/cogview-4"
      }
    },
    "list": [
      {
        "id": "main",
        "model": "deepseek/deepseek-flash"
      },
      {
        "id": "writer",
        "workspace": "/root/agents/writer",
        "agentDir": "/root/.openclaw/agents/writer/agent",
        "model": "deepseek/deepseek-flash"
      },
      {
        "id": "topic",
        "workspace": "/root/agents/topic",
        "agentDir": "/root/.openclaw/agents/topic/agent",
        "model": "deepseek/deepseek-flash"
      },
      {
        "id": "qa",
        "workspace": "/root/agents/qa",
        "agentDir": "/root/.openclaw/agents/qa/agent",
        "model": "deepseek/deepseek-flash"
      },
      {
        "id": "format",
        "workspace": "/root/agents/format",
        "agentDir": "/root/.openclaw/agents/format/agent",
        "model": "deepseek/deepseek-flash"
      }
    ]
  },
  "models": {
    "providers": {
      "deepseek": {
        "baseUrl": "https://api.deepseek.com/v1",
        "apiKey": "{{DEEPSEEK_API_KEY}}",
        "api": "openai-completions",
        "models": [
          { "id": "deepseek-v4-pro", "name": "DeepSeek V4 Pro" },
          { "id": "deepseek-flash", "name": "DeepSeek V4.1 Flash", "input": ["image", "text"] }
        ]
      },
      "glm": {
        "baseUrl": "https://open.bigmodel.cn/api/paas/v4",
        "apiKey": "{{GLM_API_KEY}}",
        "api": "openai-completions",
        "models": [
          { "id": "glm-4v-plus", "name": "GLM-4V Plus", "input": ["image", "text"] },
          { "id": "glm-4v", "name": "GLM-4V", "input": ["image", "text"] },
          { "id": "cogview-4", "name": "CogView-4" }
        ]
      }
    },
    "mode": "merge"
  },
  "channels": {
    "lightclawbot": {
      "accounts": {
        "{{LIGHTCLAWBOT_ACCOUNT_ID}}": {
          "apiKey": "{{LIGHTCLAWBOT_API_KEY}}"
        }
      },
      "site": "cn",
      "enabled": true
    }
  },
  "browser": {
    "enabled": false
  }
}
